PORT=3000
HOST=0.0.0.0
DATA_DIR=data

# 未单独配置家庭 BYOK 时使用的 OpenAI-compatible 默认服务，可留空。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-xxx

# 生产环境必填。BYOK_ENCRYPTION_KEY 是 32 字节 Base64 或 64 位 hex。
WX_APP_ID=
WX_APP_SECRET=
BYOK_ENCRYPTION_KEY=

# 仅本地开发可用；生产环境会强制关闭。
DEV_WECHAT_LOGIN=true

DAY_TIMEZONE_OFFSET_MINUTES=480
DAY_BOUNDARY_HOUR=4
CHAT_HISTORY_LIMIT=20
AGENT_CONFLICT_RETRIES=2
LLM_TIMEOUT_MS=60000
