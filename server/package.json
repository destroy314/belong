{
  "name": "belong-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:create-family": "node --env-file-if-exists=.env --import tsx src/create-dev-family.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
